# Copie ce fichier en .env puis change les mots de passe.
# Le fichier .env est ignoré par git : il ne sera jamais poussé.

# --- PostgreSQL (compte administrateur du serveur) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-moi-admin
POSTGRES_DB=maillots
POSTGRES_PORT=5432

# --- Un compte PostgreSQL par microservice ---
# Chaque service ne voit que son propre schéma.
ORDERS_DB_PASSWORD=change-moi-orders
INVENTORY_DB_PASSWORD=change-moi-inventory
PAYMENTS_DB_PASSWORD=change-moi-payments
AUTH_DB_PASSWORD=change-moi-auth

# --- MongoDB (catalogue) ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-moi-mongo
MONGO_DB=catalog
MONGO_CATALOG_USER=catalog_svc
MONGO_CATALOG_PASSWORD=change-moi-catalog
MONGO_PORT=27017

# --- Générateur de données ---
SEED_CUSTOMERS=2000
SEED_ORDERS=15000
SEED_RANDOM=42

# --- Comptes applicatifs de test (créés par le générateur) ---
# Mot de passe commun des utilisateurs de démo (admin, lea.analyst, ...)
SEED_USER_PASSWORD=change-moi-demo
